# CloudFront private/public keys
*.pem
*.key

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files as they are usually used to override resources locally and so
# shouldn't be checked into version control
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include lock file if you want to lock dependencies, but ignore local caches
.terraform.lock.hcl

