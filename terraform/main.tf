terraform {
  required_version = ">= 1.0.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# Provider specifically for CloudFront ACM certificates (always required in us-east-1)
provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"
}

# 1. CloudFront Public Key (Used to verify Signed URLs generated by backend)
resource "aws_cloudfront_public_key" "playback_key" {
  encoded_key = file(var.public_key_pem_path)
  name        = var.key_pair_name
  comment     = "Public key for White Coat Academy video playback URL signing"
}

# 2. CloudFront Key Group
resource "aws_cloudfront_key_group" "playback_keygroup" {
  items   = [aws_cloudfront_public_key.playback_key.id]
  name    = var.key_group_name
  comment = "Key group controlling signed URL access to private S3 video assets"
}

# 3. Origin Access Control (OAC) for secure, private S3 bucket access
resource "aws_cloudfront_origin_access_control" "s3_oac" {
  name                              = "whitecoat-s3-oac"
  description                       = "OAC for whitecoat-media-prod S3 playback"
  origin_access_control_origin_type = "s3"
  signing_behavior                  = "always"
  signing_protocol                  = "sigv4"
}

# 4. Custom Cache Policy (Compression OFF, NO Range in cache key, query strings ignored)
# NOTE: Range is NOT included in the cache key so CloudFront can serve partial byte
# requests from single cached full objects without edge cache fragmentation.
resource "aws_cloudfront_cache_policy" "video_cache_policy" {
  name        = "WhiteCoatVideoPlaybackCachePolicy"
  comment     = "Optimized for MP4/H.264 video streaming and seeking (Compression OFF, Range supported)"
  default_ttl = 86400    # 24 hours
  max_ttl     = 31536000 # 365 days
  min_ttl     = 0

  parameters_in_cache_key_and_forwarded_to_origin {
    enable_accept_encoding_brotli = false
    enable_accept_encoding_gzip   = false

    headers_config {
      header_behavior = "whitelist"
      headers {
        # Only forward headers required for CORS origin matching.
        # Range header is handled natively by CloudFront without being in the cache key.
        items = [
          "Origin",
          "Access-Control-Request-Headers",
          "Access-Control-Request-Method"
        ]
      }
    }

    query_strings_config {
      # Exclude signature query parameters from the cache key so different students
      # streaming the same lecture hit the warm edge cache.
      query_string_behavior = "none"
    }

    cookies_config {
      cookie_behavior = "none"
    }
  }
}

# 5. Response Headers Policy (CORS and Expose-Headers for HTML5/WebKit Range seeking)
resource "aws_cloudfront_response_headers_policy" "cors_policy" {
  name    = "WhiteCoatVideoCorsPolicy"
  comment = "Exposes Content-Range, Accept-Ranges, and Content-Length to web players"

  cors_config {
    access_control_allow_credentials = false
    origin_override                  = true

    items = var.cors_allowed_origins

    access_control_allow_methods = ["GET", "HEAD", "OPTIONS"]
    access_control_allow_headers = ["Range", "Origin", "Accept", "Content-Type"]
    access_control_expose_headers = [
      "Content-Range",
      "Accept-Ranges",
      "Content-Length",
      "ETag",
      "Date"
    ]
    access_control_max_age_sec = 86400
  }
}

locals {
  has_custom_domain = var.domain_name != "" && var.acm_certificate_arn != ""
  s3_origin_id      = "S3-${var.s3_bucket_name}"
}

# 6. CloudFront Distribution
resource "aws_cloudfront_distribution" "media_cdn" {
  enabled             = true
  is_ipv6_enabled     = true
  comment             = "White Coat Academy Video Playback CDN (OAC + Signed URLs)"
  default_root_object = ""
  price_class         = "PriceClass_All"

  aliases = local.has_custom_domain ? [var.domain_name] : []

  origin {
    domain_name              = "${var.s3_bucket_name}.s3.${var.aws_region}.amazonaws.com"
    origin_id                = local.s3_origin_id
    origin_access_control_id = aws_cloudfront_origin_access_control.s3_oac.id
  }

  default_cache_behavior {
    target_origin_id       = local.s3_origin_id
    viewer_protocol_policy = "redirect-to-https"
    allowed_methods        = ["GET", "HEAD", "OPTIONS"]
    cached_methods         = ["GET", "HEAD"]

    cache_policy_id            = aws_cloudfront_cache_policy.video_cache_policy.id
    response_headers_policy_id = aws_cloudfront_response_headers_policy.cors_policy.id

    # Enforce CloudFront Signed URLs via Key Group
    trusted_key_groups = [aws_cloudfront_key_group.playback_keygroup.id]
  }

  restrictions {
    geo_restriction {
      restriction_type = "none"
    }
  }

  viewer_certificate {
    cloudfront_default_certificate = !local.has_custom_domain
    acm_certificate_arn            = local.has_custom_domain ? var.acm_certificate_arn : null
    ssl_support_method             = local.has_custom_domain ? "sni-only" : null
    minimum_protocol_version       = local.has_custom_domain ? "TLSv1.2_2021" : null
  }
}

# 7. S3 Bucket Policy (Grants read-only access strictly to this CloudFront Distribution via OAC)
data "aws_iam_policy_document" "s3_oac_read" {
  statement {
    sid       = "AllowCloudFrontOACReadOnly"
    effect    = "Allow"
    actions   = ["s3:GetObject"]
    resources = ["arn:aws:s3:::${var.s3_bucket_name}/*"]

    principals {
      type        = "Service"
      identifiers = ["cloudfront.amazonaws.com"]
    }

    condition {
      test     = "StringEquals"
      variable = "AWS:SourceArn"
      values   = [aws_cloudfront_distribution.media_cdn.arn]
    }
  }
}

# SAFEGUARD: S3 bucket policy attachment is guarded by var.manage_s3_bucket_policy (default false).
# This ensures running 'terraform apply' will NEVER inadvertently overwrite or wipe out an
# existing S3 bucket policy. The required policy statement is printed as a Terraform output
# so you can safely merge it into your existing bucket policy in the AWS S3 Console.
resource "aws_s3_bucket_policy" "attach_oac_policy" {
  count  = var.manage_s3_bucket_policy ? 1 : 0
  bucket = var.s3_bucket_name
  policy = data.aws_iam_policy_document.s3_oac_read.json
}

