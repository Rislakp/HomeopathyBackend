# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/homeopathy_db
MONGODB_LOCAL_URI=mongodb://localhost:27017/homeopathy_db
USE_LOCAL_DB=false

# Authentication & JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
ALLOW_ADMIN_SIGNUP=true

# CORS Allowlist (comma-separated domains)
ALLOWED_ORIGINS=https://whitecoat.academy,https://admin.whitecoat.academy,http://localhost:3000,http://localhost:5000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional Cloudinary connection URL (alternative to individual keys):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# AI API (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
