# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/homeopathy_db
MONGODB_LOCAL_URI=mongodb://localhost:27017/homeopathy_db
USE_LOCAL_DB=false

# Authentication & JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here
JWT_REFRESH_EXPIRES_IN=30d
ALLOW_ADMIN_SIGNUP=true

# CORS Allowlist (comma-separated domains)
ALLOWED_ORIGINS=https://whitecoat.academy,https://admin.whitecoat.academy,http://localhost:3000,http://localhost:5000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional Cloudinary connection URL (alternative to individual keys):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# S3 video multipart uploads (EC2 uses its attached IAM role; do not add access keys)
AWS_REGION=us-east-1
S3_BUCKET=whitecoat-media-prod
# AI API (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery Configuration (SMTP for Admin Password Recovery)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_key
SMTP_PASS=your_smtp_password_or_secret
EMAIL_FROM="White Coat Academy" <noreply@whitecoat.academy>

# Admin Password Recovery Configuration
ADMIN_PORTAL_URL=https://admin.whitecoat.academy
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
DEMO_ADMIN_EMAIL=admin@whitecodeacademy.com
RESTRICT_DEMO_ADMIN_PASSWORD_RESET=true
